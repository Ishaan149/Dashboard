# Firebase configuration — copy this file to .env.local and fill in your values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → SDK setup
# .env.local is gitignored and never committed.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# SHA-256 hex digest of the dashboard password.
# This is a client-side convenience gate, not secure authentication.
VITE_PASSWORD_HASH=your-sha256-hex-digest

# Compatibility value written with Firestore documents. Because Vite exposes
# this value to the browser, it must not be treated as a real secret.
VITE_FIRESTORE_SECRET=your-firestore-rule-value
